# Database Direct Connection (Drizzle ORM & Supabase Transaction Pooler - 포트 6543)
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR_PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Supabase Configuration (Supabase JS SDK - Auth & Storage 전용)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# 최신 Supabase 대시보드 표준 키 명칭 (구 NEXT_PUBLIC_SUPABASE_ANON_KEY)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
