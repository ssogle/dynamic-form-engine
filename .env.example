# -----------------------------------------------------------------------------
# 1. PostgreSQL 데이터베이스 연결 문자열 (필수)
# -----------------------------------------------------------------------------
# 표준 PostgreSQL 프로토콜을 지원하는 모든 데이터베이스를 지원합니다.
# (로컬 Docker, Supabase Cloud, AWS RDS, Neon 등)
#
# - 포트 6543 (Transaction Pooler - 서버리스 환경 권장)
# - 포트 5432 (표준 직접 연결 포트)
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/[DATABASE]

# -----------------------------------------------------------------------------
# 2. Google Gemini API (필수)
# -----------------------------------------------------------------------------
# 자연어 폼 스키마 빌더 및 비정형 문서 데이터 정제 런타임에 사용됩니다.
# Google AI Studio에서 무료 발급 가능: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
