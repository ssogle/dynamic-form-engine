{
  "compilerOptions": {
    /* --------------------------------------------------
     * 1. 런타임 환경 및 빌드/트랜스파일 기본 설정
     * -------------------------------------------------- */
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"], // 브라우저 DOM API 및 최신 ECMAScript 문법 지원
    "allowJs": true, // JS 파일 혼용 허용 (필요 시 점진적 마이그레이션 가능)
    "skipLibCheck": true, // node_modules 내 외부 라이브러리의 d.ts 타입 검사 생략 (빌드 속도 최적화)
    "noEmit": true, // TS 컴파일러는 타입 체크만 수행 (실제 JS 번들링/트랜스파일은 Next.js가 담당)
    "esModuleInterop": true, // CommonJS 모듈을 ES6 모듈 형태로 매끄럽게 import 가능하도록 보정
    "module": "esnext", // 최신 ES 모듈 시스템 채택
    "moduleResolution": "bundler", // Next.js/Webpack 등 모던 번들러 환경에 최적화된 모듈 해석 방식
    "resolveJsonModule": true, // .json 파일 직접 import 허용 (다국어 i18n 사전 로드 등에 필수)
    "isolatedModules": true, // 모든 파일을 독립된 모듈로 취급 (Next.js의 SWC 단일 파일 트랜스파일 안전성 보장)
    "jsx": "react-jsx", // React 17+ 신규 JSX 트랜스폼 적용 (파일 상단 'import React' 생략 가능)
    "incremental": true, // 증분 빌드 활성화 (변경된 파일만 재검사하여 타입 체크/빌드 속도 단축)

    /* --------------------------------------------------
     * 2. Next.js 프레임워크 플러그인
     * -------------------------------------------------- */
    "plugins": [
      {
        "name": "next" // Next.js App Router 전용 타입(PageProps, Segment 등) 자동 추론 플러그인
      }
    ],

    /* --------------------------------------------------
     * 3. 엔지니어링 하네스: 엄격한 타입 검증 (Strict Guardrails)
     * -------------------------------------------------- */
    "strict": true, // TypeScript의 모든 기본 엄격 검증(strictNullChecks, noImplicitAny 등) 활성화

    // [핵심] 배열/객체 인덱스 접근 시 undefined를 강제 추론
    // - 동적 폼 엔진(submissionData[key], fields[0]) 작업 시 런타임 'Cannot read properties of undefined'를 코딩 단계에서 100% 방어
    "noUncheckedIndexedAccess": true,

    // optional 속성(key?: string)에 명시적 undefined 할당 방지
    // - 속성이 '누락된 것'과 '값이 undefined인 것'을 엄격히 구분하여 Zod 스키마 및 Gemini Structured Outputs 데이터 정합성 유지
    "exactOptionalPropertyTypes": true,

    // 함수 내 모든 분기 경로에서 명시적인 return 문을 작성하도록 강제 (조건문 누락으로 인한 암묵적 undefined 반환 차단)
    "noImplicitReturns": true,

    // switch-case 문에서 break나 return 없이 다음 case로 흘러내려가는(fallthrough) 실수 방지
    "noFallthroughCasesInSwitch": true,

    // 클래스 상속/메서드 오버라이딩 시 명시적 'override' 키워드 강제 (부모 클래스 변경 시 사이드 이펙트 추적 용이)
    "noImplicitOverride": true,

    // OS(Mac/Windows/Linux) 간 대소문자 구분 차이로 인한 배포 서버(Vercel, Docker)의 빌드 실패를 원천 방어
    "forceConsistentCasingInFileNames": true,
    "types": ["vitest/globals"],

    /* --------------------------------------------------
     * 4. FSD(Feature-Sliced Design) 레이어별 절대 경로 별칭 (Paths)
     * -------------------------------------------------- */
    "paths": {
      "@/*": ["./src/*"], // 루트 별칭
      "@/app/*": ["./src/app/*"], // App Router 라우트 레이어
      "@/widgets/*": ["./src/widgets/*"], // 독립적 대형 UI 블록 레이어
      "@/features/*": ["./src/features/*"], // 비즈니스 기능(동적 폼 빌더/파서 엔진) 레이어
      "@/entities/*": ["./src/entities/*"], // 핵심 비즈니스 도메인(폼 스키마 규격) 레이어
      "@/shared/*": ["./src/shared/*"] // 재사용 UI(shadcn), 유틸, API 클라이언트 공통 레이어
    }
  },

  /* --------------------------------------------------
   * 5. 컴파일 포함 및 제외 경로
   * -------------------------------------------------- */
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts" // vitest.config.mts 등 ESM TypeScript 설정 파일 포함
  ],
  "exclude": [
    "node_modules" // 의존성 라이브러리 검사 제외
  ]
}
